# Copy to .env for local development. Never commit the real .env — real
# values live in Render env groups / GitHub Actions secrets (see
# .github/workflows/deploy.yml and ci.yml).

# Required. Postgres connection string (Supabase, direct or pooled).
DATABASE_URL=

# Required for any authenticated route. The Supabase project's base URL
# (e.g. https://xxxxx.supabase.co) -- used to fetch its public JWKS
# endpoint (/auth/v1/.well-known/jwks.json) to verify the signature of
# Supabase-issued access tokens (ES256, this project's signing key). The
# API never sees a password or a shared secret, only these public keys.
SUPABASE_URL=

# Server
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed CORS origins, e.g.
# https://aiit.network,https://staging.aiit.network
CORS_ORIGINS=

# Optional — Sentry error reporting. Left unset, Sentry is a no-op.
SENTRY_DSN=

# Optional. Defaults shown.
LOG_LEVEL=info
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Optional. Mounts Swagger at /v1/docs outside production by default; set
# to true to also mount it in production. Not access-controlled by
# JwtGuard itself — the docs route isn't wrapped in it.
SWAGGER_ENABLED=false

# Required for the public forms (contact, newsletter, webinar, affiliate) to
# accept submissions -- TurnstileService fails closed without it, refusing
# writes rather than silently accepting unprotected ones. Cloudflare
# dashboard -> Turnstile -> your widget -> Secret Key (NOT the site key,
# which is public and goes in apps/web's VITE_TURNSTILE_SITE_KEY instead).
TURNSTILE_SECRET_KEY=

# Optional -- lets the public forms actually email a notification (contact
# message, webinar registration, affiliate application) and send the
# newsletter's double opt-in confirmation link. Left unset, EmailService
# no-ops with a logged warning; submissions still save correctly, they just
# don't notify anyone. Resend dashboard -> API Keys -> create one scoped to
# the aiit.network domain already verified there for Supabase Auth's emails.
RESEND_API_KEY=

# Optional. Base URL used to build links inside emails (e.g. the newsletter
# confirmation link). Defaults to https://aiit.network if unset.
APP_URL=https://aiit.network

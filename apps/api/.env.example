# Copy to .env for local development. Never commit the real .env — real
# values live in Render env groups / GitHub Actions secrets (see
# .github/workflows/deploy.yml and ci.yml).

# Required. Postgres connection string (Supabase, direct or pooled).
DATABASE_URL=

# Required for any authenticated route. Supabase project -> Settings ->
# API -> JWT Secret. Used to verify the signature of Supabase-issued
# access tokens (HS256) -- the API never sees a password, only this.
SUPABASE_JWT_SECRET=

# Server
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed CORS origins, e.g.
# https://aiit.network,https://staging.aiit.network
CORS_ORIGINS=

# Optional — Sentry error reporting. Left unset, Sentry is a no-op.
SENTRY_DSN=

# Optional. Defaults shown.
LOG_LEVEL=info
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Optional. Mounts Swagger at /v1/docs outside production by default; set
# to true to also mount it in production. Not access-controlled by
# JwtGuard itself — the docs route isn't wrapped in it.
SWAGGER_ENABLED=false

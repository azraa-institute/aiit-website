# Copy to .env for local development. Never commit the real .env — real
# values live in Render env groups / GitHub Actions secrets (see
# .github/workflows/deploy.yml and ci.yml).

# Required. Postgres connection string (Supabase, direct or pooled).
DATABASE_URL=

# Required for any authenticated route. The Supabase project's base URL
# (e.g. https://xxxxx.supabase.co) -- used to fetch its public JWKS
# endpoint (/auth/v1/.well-known/jwks.json) to verify the signature of
# Supabase-issued access tokens (ES256, this project's signing key). The
# API never sees a password or a shared secret, only these public keys.
SUPABASE_URL=

# Optional, but a HIGH-PRIVILEGE SECRET when set -- full admin access to
# the whole Supabase project (every table, every user), bypasses Row Level
# Security entirely. Supabase Dashboard -> Settings -> API -> service_role
# key (marked "secret" there for a reason -- never expose it client-side,
# never prefix it VITE_*). Used for exactly one thing in this codebase:
# banning a user's live Supabase session at account-deletion time
# (DELETE /me), on top of the app-level block ProfileService/JwtGuard
# already enforce without it. Left unset, deletion still fully blocks the
# account via that app-level check -- this only closes the narrower gap
# where a fresh sign-in attempt could otherwise still succeed at
# Supabase's own layer before being bounced back out.
SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed CORS origins, e.g.
# https://aiit.network,https://staging.aiit.network
CORS_ORIGINS=

# Optional — Sentry error reporting. Left unset, Sentry is a no-op.
SENTRY_DSN=

# Optional. Defaults shown.
LOG_LEVEL=info
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Optional. Mounts Swagger at /v1/docs outside production by default; set
# to true to also mount it in production. Not access-controlled by
# JwtGuard itself — the docs route isn't wrapped in it.
SWAGGER_ENABLED=false

# Required for the public forms (contact, newsletter, webinar, affiliate) to
# accept submissions -- TurnstileService fails closed without it, refusing
# writes rather than silently accepting unprotected ones. Cloudflare
# dashboard -> Turnstile -> your widget -> Secret Key (NOT the site key,
# which is public and goes in apps/web's VITE_TURNSTILE_SITE_KEY instead).
TURNSTILE_SECRET_KEY=

# Optional -- lets the public forms actually email a notification (contact
# message, webinar registration, affiliate application) and send the
# newsletter's double opt-in confirmation link. Left unset, EmailService
# no-ops with a logged warning; submissions still save correctly, they just
# don't notify anyone. Resend dashboard -> API Keys -> create one scoped to
# the aiit.network domain already verified there for Supabase Auth's emails.
RESEND_API_KEY=

# Optional. Base URL used to build links inside emails (e.g. the newsletter
# confirmation link). Defaults to https://aiit.network if unset.
APP_URL=https://aiit.network

# Optional -- syncs a privacy-minimal lead record (name/email/social links/
# follower counts/country, never phone/motivation/signature/payout data) to
# Brevo for the project owner's own affiliate outreach, on every affiliate
# application. Left unset, BrevoClientService no-ops with a logged warning;
# the application itself is entirely unaffected. Brevo dashboard -> SMTP &
# API -> API Keys. BREVO_AFFILIATE_LIST_ID is the numeric id (Brevo
# dashboard -> Contacts -> Lists) of the list new applications land in --
# optional; omitted, the contact is still upserted, just not added to a list.
BREVO_API_KEY=
BREVO_AFFILIATE_LIST_ID=

# Optional -- best-effort, server-side verification of a YouTube channel
# link given on the affiliate application (the only social platform with a
# free, no-OAuth public follower-count lookup; every other platform stays
# self-reported only). Left unset, YoutubeClientService resolves to null
# without ever contacting the API; nothing else is affected. Google Cloud
# Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials
# -> API key.
YOUTUBE_API_KEY=

# Required for live classes (the in-portal classroom). LiveKit Cloud project ->
# Settings -> Keys. LIVEKIT_API_SECRET is a HIGH-PRIVILEGE SECRET: it signs
# every classroom join token, so it lives ONLY here (Render env), never in
# apps/web, never VITE_*-prefixed, never committed. Left unset, the join
# endpoint answers 503 "Live classes are not configured yet" and nothing else
# is affected. Also add https://<api-host>/v1/livekit/webhook as a webhook
# endpoint in the LiveKit dashboard so attendance is recorded.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Required for PayPal checkout (paid courses). developer.paypal.com -> Apps &
# Credentials -> (Sandbox while testing, Live once ready) -> your app.
# PAYPAL_CLIENT_SECRET is a HIGH-PRIVILEGE SECRET: it authenticates as your
# PayPal business account, so it lives ONLY here (Render env), never in
# apps/web, never VITE_*-prefixed, never committed. Left unset, the checkout
# endpoints answer 503 "Payments are not configured yet." and nothing else is
# affected.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# https://api-m.sandbox.paypal.com while testing, https://api-m.paypal.com
# once live.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# From the same PayPal app's Webhooks tab, after adding
# https://<api-host>/v1/payments/webhooks/paypal as a webhook endpoint there
# (subscribe it to "Checkout order approved" and "Payment capture completed"
# at minimum). Used to verify inbound webhook signatures; left unset, the
# webhook always rejects as unverifiable (the synchronous capture call in
# PayPalCheckoutController is the primary confirmation path regardless, so
# checkout still works -- this only loses the "buyer closed the tab" safety
# net).
PAYPAL_WEBHOOK_ID=

# Required for Razorpay checkout (paid courses, INR). dashboard.razorpay.com
# -> Account & Settings -> API Keys (Test Mode while testing, Live Mode once
# ready -- the Key ID itself is prefixed rzp_test_/rzp_live_, no separate
# toggle to track). RAZORPAY_KEY_SECRET is a HIGH-PRIVILEGE SECRET -- server
# only, never VITE_*-prefixed. Left unset, Razorpay checkout endpoints
# answer 503 "Payments are not configured yet." and nothing else is
# affected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> add https://<api-host>/v1/payments/webhooks/razorpay
# subscribed to "payment.captured" at minimum -> the secret shown there (NOT
# the Key Secret above). Left unset, the webhook always rejects as
# unverifiable -- the synchronous /verify call is the primary confirmation
# path regardless, so checkout still works, this only loses the "buyer
# closed the tab" safety net.
RAZORPAY_WEBHOOK_SECRET=

# Required for Paystack checkout (paid courses, NGN). dashboard.paystack.com
# -> Settings -> API Keys & Webhooks (Test Mode while testing, Live Mode
# once ready -- keys are prefixed sk_test_/sk_live_ and pk_test_/pk_live_).
# PAYSTACK_SECRET_KEY is a HIGH-PRIVILEGE SECRET -- server only, never
# VITE_*-prefixed. It also signs webhooks (Paystack has no separate webhook
# secret, unlike Razorpay) -- add
# https://<api-host>/v1/payments/webhooks/paystack as a webhook URL on the
# same Settings page. Left unset, Paystack checkout endpoints answer 503
# "Payments are not configured yet." and nothing else is affected.
PAYSTACK_SECRET_KEY=

# Optional -- upgrades Quill (the course-advisor assistant on every course
# page, apps/web's CourseDetailPage -> "Ask Quill about this course") from
# its built-in rule-based engine to a real model call. Left unset, Quill
# still answers fully -- every reply is already built from real course data
# (the same public /courses/:slug the course page itself renders) plus a
# small curated set of AIIT articles, see
# apps/api/src/modules/quill/quill.service.ts's own doc comment for exactly
# where this plugs in once set. x.ai Console -> API Keys (Grok).
# XAI_API_KEY is a HIGH-PRIVILEGE SECRET -- server only, never
# VITE_*-prefixed. Once this is set, revisit QuillController's @Throttle
# limit too -- it was chosen to bound abuse of a free rule-based engine, not
# per-message LLM cost.
XAI_API_KEY=

# Required for the admin portal's Blog feature (apps/api/src/modules/admin/
# admin-blog.*, github-publisher.service.ts) to actually publish a post --
# "Publish" commits a Markdown file straight into
# apps/web/src/content/posts/, which is what the live Resources pages
# render from. GitHub -> Settings -> Developer settings -> Fine-grained
# personal access tokens -> generate one scoped to ONLY this repo, with
# Contents: Read and write permission (nothing else). HIGH-PRIVILEGE SECRET
# -- server only, never VITE_*-prefixed, never committed. Left unset, every
# publish/unpublish action fails with a clear "Publishing is not configured"
# error -- drafts (create/edit/preview) still work fully without it.
GITHUB_TOKEN=
# "owner/repo", e.g. Ndubuisi-Godcares/azraa-aiit.
GITHUB_REPO=
# Defaults to "main" if unset -- the branch posts are committed to.
GITHUB_BRANCH=
# Defaults to "apps/web/src/content/posts" if unset.
GITHUB_POSTS_PATH=

# Required for video uploads in the admin blog editor's media library
# (apps/api/src/common/r2/r2.service.ts) to actually work -- the browser
# uploads the video file directly to this Cloudflare R2 bucket via a
# short-lived signed URL this server generates, never through this server
# itself. Left unset, the presign-video endpoint answers 503 "Video uploads
# are not configured yet" -- image/audio uploads (still Supabase-backed) and
# everything else about the blog editor keep working fully without it.
#
# Cloudflare dashboard -> R2 -> Overview page for R2_ACCOUNT_ID. Create the
# bucket first (e.g. "aiit-media"), then R2 -> Manage API Tokens -> Create
# Account API Token: permission "Object Read & Write", scoped to that one
# bucket only ("Apply to specific buckets only"), TTL "Forever", no IP
# filtering. The result page gives the Access Key + Secret Access Key below
# (ignore "Token value"/"Token ID" there, those are for Cloudflare's own
# management API, not S3-style object access).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
# HIGH-PRIVILEGE SECRET -- server only, never VITE_*-prefixed, never committed.
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The bucket's public base URL -- either its R2.dev dev subdomain (bucket
# Settings -> Public Access; fine for testing, not meant for production
# traffic) or a custom domain mapped to the bucket (bucket Settings ->
# Public Access -> Custom Domains; requires this domain's DNS to be on
# Cloudflare's own nameservers). No trailing slash.
R2_PUBLIC_URL=

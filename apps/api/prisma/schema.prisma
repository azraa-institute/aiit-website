// Phase 1: real auth (profiles + the on_auth_user_created trigger, both
// with RLS) and a database-backed course catalogue, per
// backend-implementation-plan.pdf. Curriculum tables (course_modules,
// lessons, lesson_resources) exist and are RLS'd but seed empty — no
// course has real curriculum content yet.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

enum Role {
  learner
  admin
  instructor

  @@schema("public")
}

enum ProfileStatus {
  active
  suspended
  pending_deletion

  @@schema("public")
}

// auth.users is Supabase-managed, not modeled here — the FK to it is raw
// SQL in the migration, not a Prisma relation (see migration.sql). Even
// unmodeled, Prisma's multiSchema feature needs `auth` listed above and
// this model assigned to a schema, or `prisma migrate diff` can't
// reconcile the cross-schema FK when introspecting the database.
model Profile {
  id                  String        @id @db.Uuid
  role                Role          @default(learner)
  status              ProfileStatus @default(active)
  name                String?
  headline            String?
  // Contact-info string; verification is via Supabase Auth's own phone-OTP
  // flow (supabase.auth.updateUser({phone}) + verifyOtp), not modeled here.
  // phoneVerifiedAt is only ever set by ProfileService.confirmPhoneVerification,
  // which checks the *auth* user's phone_confirmed_at via the Supabase Admin
  // API first -- this column is never trusted from a plain client PATCH.
  phone               String?
  phoneVerifiedAt     DateTime?     @map("phone_verified_at") @db.Timestamptz(6)
  qualification       String? // highest qualification, free text (UI offers a fixed picklist + "Other")
  university          String? // institution attended -- AIIT is not itself an accredited university, this is the learner's own prior/current one
  fieldOfStudy        String?       @map("field_of_study")
  currentStatus       String?       @map("current_status") // student / working professional / job seeker / other
  learningGoal        String?       @map("learning_goal") // primary reason for joining, free text (UI offers a fixed picklist + "Other")
  areasOfInterest     String[]      @default([]) @map("areas_of_interest") // AI, Data Science, Cybersecurity, etc. -- see data/learningAreas.ts
  timeZone            String?       @map("time_zone") // IANA zone, e.g. "Africa/Lagos" -- client-detected default, editable
  country             String?       @db.Char(2) // ISO 3166-1 alpha-2
  // State/province and city are both free text here, same convention as
  // university/qualification below -- the UI picks them from the
  // GeoState/GeoCity cascading lookup (see those models), but what's
  // stored is just the chosen NAME, not a foreign key. That keeps a
  // profile readable/exportable on its own and immune to the lookup
  // tables ever being re-seeded or renumbered later; the tradeoff is a
  // profile doesn't get an automatic update if a place is ever renamed.
  state               String?
  city                String?
  address             String?
  postalCode          String?       @map("postal_code")
  avatarKey           String?       @map("avatar_key") // object-storage key, not a URL
  preferences         Json          @default("{}")
  deletionRequestedAt DateTime?     @map("deletion_requested_at") @db.Timestamptz(6)
  welcomedAt          DateTime?     @map("welcomed_at") @db.Timestamptz(6) // set the first time GET /auth/me sees this profile -- guards the one-time welcome email
  // Set when an admin suspends the account (students and instructors). JwtGuard
  // answers a suspended account with its own "suspended" message rather than the
  // "deleted" one, and the Supabase session is banned so it cannot refresh.
  suspendedAt         DateTime?     @map("suspended_at") @db.Timestamptz(6)
  suspendedReason     String?       @map("suspended_reason")
  // True for a staff account created by an admin with a temporary password --
  // the staff portal forces a password change before anything else.
  mustChangePassword  Boolean       @default(false) @map("must_change_password")
  createdBy           String?       @map("created_by") @db.Uuid // the admin who created this (staff) account
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
  @@schema("public")
}

// ---- Geography lookup ----
// Static reference data (states/provinces + cities), seeded once from the
// dr5hn/countries-states-cities-database open dataset directly in this
// migration's own SQL -- not fetched at runtime, not re-synced. Powers the
// Profile wizard/page's Country -> State -> City cascade: GET /geo/states
// and GET /geo/cities read these, but nothing in the app ever writes to
// them (no admin UI, no user input flows back here), so there's no write
// RLS policy, only public_read. Ids are the SOURCE dataset's own numeric
// ids, kept as-is (not re-generated) so GeoCity.stateId stays a stable,
// meaningful join without an extra remapping step during the import.
model GeoState {
  id          Int       @id
  name        String
  countryCode String    @map("country_code") @db.Char(2) // ISO 3166-1 alpha-2, matches Profile.country / data/countries.ts
  cities      GeoCity[]

  @@index([countryCode])
  @@map("geo_states")
  @@schema("public")
}

model GeoCity {
  id      Int      @id
  name    String
  stateId Int      @map("state_id")
  state   GeoState @relation(fields: [stateId], references: [id])

  @@index([stateId])
  @@map("geo_cities")
  @@schema("public")
}

// ---- Catalogue ----
// Deliberately named CourseLifecycleStatus, not "status" — the frontend's
// existing CourseStatus type (featured/new/hot/special/coming-soon, see
// apps/web/src/data/types.ts) is a set of marketing badges, unrelated to
// publish lifecycle. Renamed to CourseBadge below to keep them distinct.

enum CourseLevel {
  beginner
  intermediate
  advanced
  all_levels // API response DTO maps this to the frontend's "All levels"
  // Added for the 2026-09 catalogue taxonomy update -- several programmes
  // deliberately span two levels (e.g. Cisco CCNA reads "Beginner–Intermediate").
  // Postgres can't use a value added by ALTER TYPE ... ADD VALUE in the same
  // transaction that adds it, so these are introduced in their own migration
  // (20260919000000_course_level_extra_values) ahead of the migration that
  // actually assigns them to any course.
  absolute_beginner
  beginner_intermediate
  intermediate_advanced

  @@schema("public")
}

enum PricingModel {
  paid
  free
  subscription

  @@schema("public")
}

enum CourseBadge {
  featured
  new_badge // API response DTO maps this to the frontend's "new"
  hot
  special
  coming_soon // API response DTO maps this to the frontend's "coming-soon"

  @@schema("public")
}

enum CourseLifecycleStatus {
  draft
  published

  @@schema("public")
}

enum DomainMotif {
  lattice
  flow
  strata
  field
  horizon
  depth
  mesh
  signal

  @@schema("public")
}

model CourseDomain {
  id         String           @id @default(uuid()) @db.Uuid
  slug       String           @unique
  name       String
  tagline    String
  summary    String
  motif      DomainMotif
  order      Int
  primary    Boolean          @default(false)
  image      String
  categories CourseCategory[]
  courses    Course[]
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("course_domains")
  @@schema("public")
}

model CourseCategory {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  domainId  String?       @map("domain_id") @db.Uuid
  domain    CourseDomain? @relation(fields: [domainId], references: [id])
  courses   Course[]
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("course_categories")
  @@schema("public")
}

model Course {
  id               String                @id @default(uuid()) @db.Uuid
  slug             String                @unique
  title            String
  categoryId       String                @map("category_id") @db.Uuid
  category         CourseCategory        @relation(fields: [categoryId], references: [id])
  domainId         String?               @map("domain_id") @db.Uuid
  domain           CourseDomain?         @relation(fields: [domainId], references: [id])
  // The catalogue's top-level "Category" (Artificial Intelligence & Intelligent
  // Systems, Cybersecurity & Networking, etc.) -- deliberately separate from
  // CourseDomain/CourseCategory above rather than folded into either: CourseDomain
  // is the older, decorative "technology domain" concept (homepage focus rail,
  // Plate motif art, its own icon per domain) and several of its rows don't map
  // 1:1 onto the new taxonomy (Edge Computing and Quantum Computing become one
  // catalogue category, "Emerging & Advanced Computing", but stay two separate,
  // untouched CourseDomain rows so the homepage rail keeps its five distinct
  // domains). CourseCategory.name became the new "Subcategory" instead (e.g.
  // "Networking" / "Cybersecurity", split out of the old shared "Networking &
  // Cybersecurity" category). A plain slug string, not a CatalogueCategory enum
  // or its own table -- the fixed set of 9 category slugs/names lives in
  // @aiit/shared's CATALOGUE_CATEGORIES so backend and frontend share one
  // definition without a schema migration every time copy changes.
  // Nullable: a course row this migration doesn't know about (there
  // shouldn't be one, but nothing guarantees it) simply falls back to a
  // generic label via catalogue.mappers.ts's mapCatalogueCategory rather
  // than being unable to load at all.
  catalogueCategory String?              @map("catalogue_category")
  // Structured "What you'll explore" data for the course-detail page --
  // CourseTechnology[] (see @aiit/shared): { name, type, icon, tier? }. Kept as
  // a single JSON column rather than a join table since it's small, per-course,
  // and has no independent identity of its own (nothing else references a
  // single technology row) -- the existing toolsCovered TEXT[] below stays for
  // backward compatibility but is no longer what the detail page renders.
  technologies     Json                  @default("[]")
  summary          String
  description      String
  priceUsdCents    Int?                  @map("price_usd_cents") // null = members/subscription only; USD is the sole canonical price, no per-currency columns
  priceWasUsdCents Int?                  @map("price_was_usd_cents")
  pricing          PricingModel
  level            CourseLevel
  durationHours    Int                   @map("duration_hours")
  durationLabel    String                @map("duration_label")
  rating           Decimal               @db.Decimal(2, 1)
  ratingCount      Int                   @map("rating_count")
  badges           CourseBadge[]
  instructorId     String?               @map("instructor_id") // no FK -- instructors aren't a DB table this phase
  image            String
  outcomes         String[]
  requirements     String[]
  audience         String[]
  toolsCovered     String[]              @map("tools_covered")
  certification    String
  status           CourseLifecycleStatus @default(draft)
  publishedAt      DateTime?             @map("published_at") @db.Timestamptz(6)
  modules          CourseModule[]
  enrollments      Enrollment[]
  assignments      Assignment[]
  certificates     Certificate[]
  timetables       Timetable[]
  liveClasses      LiveClass[]
  instructors      CourseInstructor[]
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?             @map("deleted_at") @db.Timestamptz(6)

  @@map("courses")
  @@schema("public")
}

// ---- Learner portal: enrollment ----
// The public "Enrolled" figure on course cards/pages is derived from this
// table (non-cancelled rows per course, see CoursesService) -- the old static
// Course.enrolled_count marketing number was removed. The DB column is left in
// place (zeroed, default 0) so the previous API build keeps working during a
// deploy; drop it in a later migration.

enum EnrollmentStatus {
  active
  completed
  cancelled

  @@schema("public")
}

model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid // references auth.users.id, not a Prisma relation -- see Profile
  courseId    String           @map("course_id") @db.Uuid
  course      Course           @relation(fields: [courseId], references: [id])
  status      EnrollmentStatus @default(active)
  enrolledAt  DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, courseId])
  @@map("enrollments")
  @@schema("public")
}

// ---- Learner portal: assignments ----
// Submission status (upcoming/overdue/submitted/graded) is deliberately NOT
// a stored column -- it's derived from submittedAt/gradedAt/dueAt in
// AssignmentsService each time it's read, so it can never drift out of sync
// with the timestamps that actually define it.

model Assignment {
  id          String                 @id @default(uuid()) @db.Uuid
  courseId    String                 @map("course_id") @db.Uuid
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  dueAt       DateTime?              @map("due_at") @db.Timestamptz(6)
  submissions AssignmentSubmission[]
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("assignments")
  @@schema("public")
}

model AssignmentSubmission {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id") @db.Uuid
  fileKey      String?    @map("file_key") // Supabase Storage object key, not a URL -- same convention as Profile.avatarKey
  note         String?
  submittedAt  DateTime?  @map("submitted_at") @db.Timestamptz(6)
  grade        String?
  feedback     String?
  gradedAt     DateTime?  @map("graded_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([assignmentId, userId])
  @@map("assignment_submissions")
  @@schema("public")
}

// ---- Learner portal: certificates ----
// Issued only via @Roles('admin') (CertificatesService.issue), which also
// marks the learner's Enrollment completed in the same call -- there is no
// automatic "100% of lessons done" trigger, since course curricula are
// currently empty. No admin UI yet; a real, correctly-gated API call.

model Certificate {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  course       Course   @relation(fields: [courseId], references: [id])
  credentialId String   @unique @map("credential_id")
  // Snapshotted from Profile.name at issuance -- a certificate is a fixed
  // historical record, so it must keep showing the name as it was on the
  // day it was earned even if the learner renames themselves afterwards.
  holderName   String   @map("holder_name")
  issuedAt     DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  @@unique([userId, courseId])
  @@map("certificates")
  @@schema("public")
}

// ---- Learner portal: notifications ----
// No self-insert RLS policy, deliberately -- a notification only ever comes
// from NotificationsService.create(), called by the API's other services
// (enrollment, grading, certificate issuance) via the service-role
// connection. A client has no legitimate reason to write one directly.
// href is a plain string, not a FK -- it's a frontend route, e.g.
// "/portal/certificates", not a reference to another table's row.

enum NotificationKind {
  course
  certificate
  assignment
  webinar
  system

  @@schema("public")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  kind      NotificationKind
  title     String
  body      String?
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("notifications")
  @@schema("public")
}

// Named CourseModule, not Module -- every NestJS file in this codebase
// imports Module from @nestjs/common; a same-named Prisma model is a
// constant footgun even though technically resolvable via aliasing.
model CourseModule {
  id        String    @id @default(uuid()) @db.Uuid
  courseId  String    @map("course_id") @db.Uuid
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  lessons   Lesson[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("course_modules")
  @@schema("public")
}

model Lesson {
  id              String           @id @default(uuid()) @db.Uuid
  moduleId        String           @map("module_id") @db.Uuid
  module          CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug            String           @unique
  title           String
  summary         String? // short blurb, safe to expose without enrollment; full body is Phase 2+
  order           Int
  durationMinutes Int?             @map("duration_minutes")
  resources       LessonResource[]
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)

  @@map("lessons")
  @@schema("public")
}

model LessonResource {
  id        String   @id @default(uuid()) @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title     String
  url       String
  order     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("lesson_resources")
  @@schema("public")
}

// ---- Public forms ----
// All four are anonymous, unauthenticated submissions -- no user_id, no
// self-select/insert RLS policy (there is no "self" to scope to). The API's
// service-role connection writes them directly; RLS here is defense-in-depth
// against direct client access, staff-read-only, matching the pattern
// already used for admin-only tables elsewhere in this schema.
// `topic`/`region`/`persona`/`source`/`intent` are plain validated strings,
// not Postgres enums -- they're staff-triage categorisation only, not
// referenced by any other table or business rule, so a DTO-level `@IsIn`
// carries the same safety without a migration every time a category is
// tweaked.

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("contact_messages")
  @@schema("public")
}

enum NewsletterStatus {
  pending
  confirmed
  unsubscribed

  @@schema("public")
}

// Double opt-in: a row is created `pending` with a confirmToken on first
// signup, flips to `confirmed` when that token is redeemed, and to
// `unsubscribed` (via the separate unsubscribeToken, valid regardless of
// status) if the subscriber opts out later. No campaign-sending exists yet
// -- this only gates whether a future sender may email this address.
model NewsletterSubscriber {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique
  status           NewsletterStatus @default(pending)
  confirmToken     String           @unique @map("confirm_token")
  unsubscribeToken String           @unique @map("unsubscribe_token")
  confirmedAt      DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  unsubscribedAt   DateTime?        @map("unsubscribed_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("newsletter_subscribers")
  @@schema("public")
}

// Unique per (email, webinarSlug) rather than per email alone -- the current
// registration form only ever submits one featured webinar at a time, but a
// bare per-email unique would wrongly block someone from registering for a
// later, different webinar.
model WebinarRegistration {
  id          String   @id @default(uuid()) @db.Uuid
  webinarSlug String   @map("webinar_slug")
  name        String
  email       String
  whatsapp    String?
  region      String
  persona     String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([email, webinarSlug])
  @@map("webinar_registrations")
  @@schema("public")
}

model AffiliateApplication {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String
  phone        String?
  handle       String?
  country      String?
  city         String?
  referralCode String?  @map("referral_code")
  source       String?
  intent       String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("affiliate_applications")
  @@schema("public")
}

// An append-only audit trail for the cookie-consent panel (see
// CookieConsentContext.tsx) -- every accept/decline/save is a NEW row,
// never an update, so the full history of a visitor's choices over time
// is preserved rather than overwritten. localStorage remains the source
// of truth the frontend actually reads to decide whether to show the
// panel; this table exists purely so a decision can be proven later
// (date, choice, and by whom/where) if ever needed.
model CookieConsentLog {
  id          String   @id @default(uuid()) @db.Uuid
  // A random id the frontend generates once and keeps in localStorage
  // alongside the consent choice -- lets multiple decisions from the same
  // browser over time be correlated without identifying the person. Not
  // sent anywhere else and not itself a cross-site tracking mechanism.
  visitorId   String   @map("visitor_id") @db.Uuid
  // References auth.users.id, not a Prisma relation -- same convention
  // as every other user reference in this schema (see Enrollment.userId).
  // Null for an anonymous visitor; set when the browser happened to hold
  // a valid session at the moment of the decision.
  userId      String?  @map("user_id") @db.Uuid
  analytics   Boolean
  preferences Boolean
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([visitorId])
  @@index([userId])
  @@map("cookie_consent_logs")
  @@schema("public")
}

// ---- Live classes (LiveKit) ----
// Admins build a Timetable (a weekly pattern for one course, in one time
// zone, between two dates) and generate concrete LiveClass rows from it;
// single ad-hoc classes can also be created with no timetable. The
// instructor (a Profile with role 'instructor', referenced by plain uuid --
// same no-relation convention as Enrollment.userId) only starts and runs a
// class; learners join once it is live. Video runs on LiveKit Cloud, this
// database only holds schedule + attendance. No recording columns yet (v2).

enum LiveClassStatus {
  scheduled
  live
  ended
  cancelled

  @@schema("public")
}

model Timetable {
  id         String          @id @default(uuid()) @db.Uuid
  courseId   String          @map("course_id") @db.Uuid
  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  timeZone   String          @map("time_zone") // IANA zone the slot times are written in, e.g. "Africa/Lagos"
  startsOn   DateTime        @map("starts_on") @db.Date
  endsOn     DateTime        @map("ends_on") @db.Date
  hostUserId String?         @map("host_user_id") @db.Uuid // default instructor for generated classes
  createdBy  String          @map("created_by") @db.Uuid
  slots      TimetableSlot[]
  classes    LiveClass[]
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([courseId])
  @@map("timetables")
  @@schema("public")
}

model TimetableSlot {
  id              String    @id @default(uuid()) @db.Uuid
  timetableId     String    @map("timetable_id") @db.Uuid
  timetable       Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  weekday         Int // 0 = Sunday ... 6 = Saturday
  startTime       String    @map("start_time") // "HH:MM", 24h, in the timetable's time zone
  durationMinutes Int       @map("duration_minutes")

  @@unique([timetableId, weekday, startTime])
  @@map("timetable_slots")
  @@schema("public")
}

model LiveClass {
  id               String                @id @default(uuid()) @db.Uuid
  courseId         String                @map("course_id") @db.Uuid
  course           Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  timetableId      String?               @map("timetable_id") @db.Uuid
  timetable        Timetable?            @relation(fields: [timetableId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  startsAt         DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime              @map("ends_at") @db.Timestamptz(6)
  status           LiveClassStatus       @default(scheduled)
  hostUserId       String?               @map("host_user_id") @db.Uuid
  roomName         String                @unique @map("room_name") // LiveKit room, "class-<id>"
  joinOpensMinutes Int                   @default(15) @map("join_opens_minutes")
  startedAt        DateTime?             @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime?             @map("ended_at") @db.Timestamptz(6)
  attendance       LiveClassAttendance[]
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([timetableId, startsAt])
  @@index([courseId, startsAt])
  @@index([hostUserId])
  @@map("live_classes")
  @@schema("public")
}

model LiveClassAttendance {
  id            String    @id @default(uuid()) @db.Uuid
  liveClassId   String    @map("live_class_id") @db.Uuid
  liveClass     LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  userId        String    @map("user_id") @db.Uuid
  firstJoinedAt DateTime  @map("first_joined_at") @db.Timestamptz(6)
  lastJoinedAt  DateTime? @map("last_joined_at") @db.Timestamptz(6) // set while connected, cleared on leave
  lastLeftAt    DateTime? @map("last_left_at") @db.Timestamptz(6)
  totalSeconds  Int       @default(0) @map("total_seconds")

  @@unique([liveClassId, userId])
  @@map("live_class_attendance")
  @@schema("public")
}

// ---- Audit log ----
// Append-only record of admin actions on other people's accounts (create,
// suspend, reactivate, password reset ...). Nothing in the app updates or
// deletes rows here.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String // e.g. "instructor.create", "user.suspend"
  targetType String   @map("target_type") // "user" | "timetable" | ...
  targetId   String?  @map("target_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
  @@schema("public")
}

// Which instructors teach which course. Set by an admin; drives who a generated
// timetable's classes are assigned to and (in the instructor portal) which
// courses, rosters and assignments an instructor can see. instructor_id is a
// plain uuid to a Profile with role 'instructor' (same no-relation convention
// as Enrollment.userId).
model CourseInstructor {
  courseId     String   @map("course_id") @db.Uuid
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorId String   @map("instructor_id") @db.Uuid
  assignedBy   String?  @map("assigned_by") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@id([courseId, instructorId])
  @@index([instructorId])
  @@map("course_instructors")
  @@schema("public")
}

# Supabase project keys (Settings -> API in the Supabase dashboard). The
# anon key is safe to expose client-side -- it's constrained by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the AIIT API (apps/api), no trailing slash.
VITE_API_URL=http://localhost:3000

# Cloudflare Turnstile site key (public, safe to expose client-side --
# Cloudflare dashboard -> Turnstile -> your widget -> Site Key). Required for
# the four public forms (contact, newsletter, webinar, affiliate) to submit;
# the secret key counterpart is server-side only, see apps/api/.env.example.
VITE_TURNSTILE_SITE_KEY=

# Optional -- Sentry error reporting. Left unset, Sentry is a no-op (same as
# apps/api's SENTRY_DSN). Sentry dashboard -> aiit-web project -> Settings ->
# Client Keys (DSN). A DSN identifies where to send events, not a secret --
# safe to ship in the client bundle.
VITE_SENTRY_DSN=

# Optional -- tags Sentry events with the real Vercel environment. Vite's own
# MODE is "production" for both a Preview and a Production deploy, so without
# this, preview traffic and real production traffic land in Sentry
# indistinguishable from each other. In Vercel, add this same variable name
# TWICE with different values scoped per environment: "production" (checked
# for Production only) and "preview" (checked for Preview only). Falls back
# to MODE if unset (fine for local dev).
VITE_VERCEL_ENV=

# Optional, build-time only (not shipped to the browser -- read by
# vite.config.ts, not application code). Uploads production source maps to
# Sentry for readable stack traces, then deletes the local .map files.
# Without SENTRY_AUTH_TOKEN set, no source maps are generated or uploaded --
# error reporting above still works, just with minified stack traces.
# Sentry dashboard -> Settings -> Auth Tokens (needs project:releases scope).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=aiit-web

# --- Payment method picker (PaymentMethodPicker.tsx) -- each of the three
# providers below is independent: any subset can be configured, the picker
# only shows cards for the ones with a public key set here, and the "ask
# about this course" fallback only shows if none are.

# Public PayPal Client ID (safe client-side -- same value as apps/api's
# PAYPAL_CLIENT_ID, the secret counterpart stays server-side only, see
# apps/api/.env.example). Used by the PayPal JS SDK to render the checkout
# button on a paid course's page. Left unset, that payment-method row
# doesn't render (Razorpay's row, below, is independent and still shows if
# it's configured -- the "ask about this course" fallback only shows if
# neither is).
VITE_PAYPAL_CLIENT_ID=

# Public Razorpay Key ID (safe client-side -- same value as apps/api's
# RAZORPAY_KEY_ID). Used by Checkout.js to open the payment modal. Left
# unset, that payment-method row doesn't render.
VITE_RAZORPAY_KEY_ID=

# Public Paystack key (safe client-side -- same value as apps/api's
# PAYSTACK_SECRET_KEY's matching public key, pk_test_/pk_live_). Used by
# Paystack's Inline v2 JS to resume a server-initialized transaction. Left
# unset, that payment-method row doesn't render.
VITE_PAYSTACK_PUBLIC_KEY=


# Supabase project keys (Settings -> API in the Supabase dashboard). The
# anon key is safe to expose client-side -- it's constrained by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the AIIT API (apps/api), no trailing slash.
VITE_API_URL=http://localhost:3000

# Cloudflare Turnstile site key (public, safe to expose client-side --
# Cloudflare dashboard -> Turnstile -> your widget -> Site Key). Required for
# the four public forms (contact, newsletter, webinar, affiliate) to submit;
# the secret key counterpart is server-side only, see apps/api/.env.example.
VITE_TURNSTILE_SITE_KEY=

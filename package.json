{
  "name": "aiit-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AIIT — Azraa Institute of Information Technology. Premium future-tech learning platform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=apps/api --if-present",
    "test:e2e": "npm run test:e2e --workspace=apps/api",
    "docs:pdf": "node scripts/build-docs-pdf.mjs"
  }
}
